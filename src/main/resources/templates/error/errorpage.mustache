<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BatikHub - Terjadi Kesalahan</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#FBF9F4] text-stone-800 antialiased min-h-screen flex flex-col justify-between">

  <main class="flex-grow flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white border border-stone-200/80 shadow-md rounded-2xl p-6 text-center space-y-5">
      
      <div class="w-14 h-14 bg-red-50 text-red-600 border border-red-100 rounded-2xl flex items-center justify-center mx-auto shadow-sm">
        <i data-lucide="alert-triangle" class="w-7 h-7"></i>
      </div>

      <div class="space-y-1.5">
        <span class="text-[10px] font-mono font-bold tracking-widest text-stone-400 uppercase block">Status Eror: {{errorStatus}}</span>
        <h1 class="text-base font-bold text-stone-900">Operasi Gagal Diproses</h1>
        <p class="text-xs text-stone-500 leading-relaxed bg-stone-50 p-3 rounded-xl border border-stone-100 font-mono text-left break-words">
          {{errorMessage}}
        </p>
      </div>

    </div>
  </main>

  <footer class="text-center py-6 text-xs text-stone-400 w-full bg-white border-t border-stone-100">
    &copy; 2026 BatikHub Nusantara. Sistem Proteksi Global.
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Panel - Pesanan Sedang Dikirim</title>
  <!-- Menggunakan Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons untuk ikon modern -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#FBF9F4] text-stone-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- NAVBAR UTAMA SYSTEM (STAFF / SELLER) -->
  {{> staff/NavbarMain/navbar}}

  <!-- KONTEN UTAMA DASHBOARD STAFF -->
  <main class="max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-grow space-y-6">
    
    <!-- NAVBAR INTERNAL (OMSET, LIST, SEDANG DIKIRIM, PROFILE) -->
    {{> staff/NavbarMain/navbarInternal}}

    <!-- HEADER LOGISTIK -->
    <div class="bg-white p-4 rounded-xl border border-stone-200/60 shadow-sm flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i data-lucide="navigation" class="w-4 h-4 text-amber-600"></i>
        <h2 class="text-xs font-bold text-stone-700 uppercase tracking-wider">Pelacakan Paket Pengiriman Aktif</h2>
      </div>
      <span class="text-[10px] font-mono bg-stone-100 text-stone-600 px-2.5 py-1 rounded-md border border-stone-200">
        Total: {{totalPaket}} Paket
      </span>
    </div>

    <!-- DAFTAR BARANG SEDANG DIKIRIM (CARD LIST LAYOUT) -->
    <div class="space-y-4">
      
      <!-- DATA PESANAN 1 (KHAIRY AIMAR) -->
       {{#transaksi}}
      <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-hidden flex flex-col md:flex-row">
        <!-- Kolom Kiri: Visual Produk & Kode -->
        <div class="p-6 bg-stone-50/50 md:w-56 border-b md:border-b-0 md:border-r border-stone-100 flex flex-col items-center justify-center text-center flex-shrink-0">
          <!-- Ukuran Gambar Diperbesar Ekstra (w-32 h-32) & Label Produk A/B Dihapus -->
          <div class="w-32 h-32 bg-white border border-stone-200 rounded-2xl flex flex-col items-center justify-center text-stone-400 shadow-sm relative overflow-hidden">
            <img src="data:image/png;base64,{{gambarProduk}}" 
                        alt="{{gambarProduk}}" 
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
            <i data-lucide="image" class="w-8 h-8 text-stone-200"></i>
          </div>
          <div class="mt-3">
            <span class="text-[9px] text-stone-400 font-mono block">KODE BARANG / SKU</span>
            <span class="text-xs font-mono font-bold text-stone-600">{{idProduk}}</span>
          </div>
        </div>

        <!-- Kolom Kanan: Informasi Detail Pengiriman -->
        <div class="p-6 flex-grow space-y-4 flex flex-col justify-between">
          
          <!-- Detail Atas: Info Barang & Ringkasan Kuantitas/Harga (Status Kurir Dihapus) -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-stone-100 pb-3">
            <div>
              <h3 class="font-bold text-stone-800 text-base leading-tight">{{namaProduk}}</h3>
              <p class="text-[10px] font-mono text-stone-400 mt-1">ID Transaksi: {{idTransaksi}}</p>
            </div>
            
            <div class="text-left sm:text-right flex sm:flex-col gap-4 sm:gap-1 justify-between items-baseline sm:items-end bg-stone-50 sm:bg-transparent p-2 sm:p-0 rounded-lg w-full sm:w-auto">
              <div>
                <span class="text-[10px] text-stone-400 block uppercase tracking-wider font-semibold">Total Dibeli</span>
                <span class="text-sm font-bold text-amber-900 font-mono bg-amber-100/70 px-2 py-0.5 rounded border border-amber-200/50 sm:border-0 sm:bg-transparent sm:p-0">{{totalDibeli}} Pcs</span>
              </div>
              <div>
                <span class="text-[10px] text-stone-400 block uppercase tracking-wider font-semibold">Harga (Satu Produk)</span>
                <span class="text-sm font-bold text-emerald-800 font-mono">$ {{hargaProduk}}</span>
              </div>
            </div>
          </div>

          <!-- Detail Bawah: Penerima & Alamat Lengkap -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-stone-50/40 p-4 rounded-xl border border-stone-200/40 text-xs">
            <div>
              <span class="text-stone-400 block font-medium mb-0.5">Nama Penerima:</span>
              <span class="text-stone-800 font-bold flex items-center gap-1 text-[13px]">
                <i data-lucide="user" class="w-3.5 h-3.5 text-amber-600"></i> {{namaPembeli}}
              </span>
            </div>
            <div class="sm:col-span-2">
              <span class="text-stone-400 block font-medium mb-0.5">Alamat Lengkap Tujuan Pengiriman:</span>
              <span class="text-stone-600 leading-relaxed block">
                {{alamatPembeli}}
              </span>
            </div>
          </div>

        </div>
      </div>
      {{/transaksi}}

    </div>

  </main>

  <!-- FOOTER PANEL -->
  <footer class="text-center py-6 text-xs text-stone-400 w-full bg-white border-t border-stone-100">
    &copy; 2026 BatikHub Staff Hub Nusantara. Dashboard Manajemen Internal.
  </footer>

  <!-- Script untuk inisialisasi Lucide Icons -->
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
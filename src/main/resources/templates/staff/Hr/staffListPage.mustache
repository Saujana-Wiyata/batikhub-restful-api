<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Panel - Daftar Seluruh Karyawan</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#FBF9F4] text-stone-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- NAVBAR -->
  {{> staff/NavbarMain/navbar}}
  
  <!-- KONTEN UTAMA -->
  <main class="max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-grow space-y-4">
    
    <div class="flex items-center justify-between">
      <a href="/profileemployee" class="inline-flex items-center gap-2 text-xs font-semibold text-stone-600 hover:text-amber-700 bg-white px-4 py-2 rounded-xl border border-stone-200/80 shadow-sm transition-all active:scale-95">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Kembali ke Profile
      </a>
      
      <span class="text-xs text-stone-400 font-medium">Total Entitas: <span class="text-stone-700 font-bold">{{totalStaff}} Orang</span></span>
    </div>

    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-hidden">
      
      <div class="px-6 py-5 bg-stone-50 border-b border-stone-100 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-stone-900 flex items-center justify-center text-amber-400 shadow-sm">
          <i data-lucide="users" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="text-base font-bold text-stone-950">Daftar Seluruh Karyawan</h1>
          <p class="text-xs text-stone-500">Hak Akses Manajemen Eksekutif (CEO & HR) untuk memantau status internal staff.</p>
        </div>
      </div>

      <!-- TABEL RESPONSIVE -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-stone-50/50 border-b border-stone-100 text-[10px] font-bold text-stone-400 uppercase tracking-wider">
              <th class="py-4 px-6">Nama Karyawan</th>
              <th class="py-4 px-6">ID Karyawan</th>
              <th class="py-4 px-6">Jabatan</th>
              <th class="py-4 px-6">Role Sistem</th>
              <th class="py-4 px-6 text-center">Aksi Kendali</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 text-sm">
            
            <!-- Karyawan 1: HR (Termasuk dirinya sendiri) -->
             {{#staff}}
            <tr class="hover:bg-stone-50/40 transition-colors">
              <td class="py-4 px-6">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full 
                              {{#ownAccount}} bg-emerald-100 text-emerald-800 flex items-center justify-center text-xs font-bold {{/ownAccount}}
                              {{#isCEO}} bg-amber-900 text-amber-100 flex items-center justify-center text-xs font-bold shadow-sm {{/isCEO}}
                              
                              {{^ownAccount}}
                              {{^isCEO}}
                                bg-stone-100 text-stone-700 flex items-center justify-center text-xs font-bold
                              {{/isCEO}}
                              {{/ownAccount}}">
                    {{inisial}}
                  </div>
                  <div>
                    <span class="font-semibold text-stone-800 block">{{name}}</span>
                    {{#ownAccount}}
                    <span class="text-[10px] text-emerald-700 bg-emerald-50 font-medium px-1.5 py-0.5 rounded">Akun Anda</span>
                    {{/ownAccount}}
                  </div>
                </div>
              </td>
              <td class="py-4 px-6 font-mono text-xs font-semibold text-stone-600">{{id}}</td>
              {{#isHR}}<td class="py-4 px-6 text-stone-600 font-medium">Human Resources</td>{{/isHR}}
              {{#isCEO}}<td class="py-4 px-6 text-stone-600 font-medium">Chief Executive Officer & Owner</td>{{/isCEO}}
              {{#isStaff}}<td class="py-4 px-6 text-stone-600 font-medium">Staff Internal</td>{{/isStaff}}
              {{#isFinance}}<td class="py-4 px-6 text-stone-600 font-medium">Finance Division</td>{{/isFinance}}
              <td class="py-4 px-6">
                <span class="{{^isCEO}}inline-flex items-center gap-1 text-xs font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200/40{{/isCEO}}
                            {{#isCEO}}inline-flex items-center gap-1 text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200/40{{/isCEO}}">
                  <i data-lucide="{{^isCEO}}shield-check{{/isCEO}}{{#isCEO}}crown{{/isCEO}}" class="w-3.5 h-3.5"></i> {{role}}
                </span>
              </td>
              <td class="py-4 px-6">
                <div class="flex items-center justify-center gap-2">
                  <!-- Tombol Data (Read Only View) -->
                   <form action="/otherstaffprofile" method="post">
                     <button type="submit" class="flex items-center gap-1 bg-sky-50 hover:bg-sky-100 text-sky-800 px-3 py-1.5 rounded-lg text-xs font-semibold border border-sky-200/40 transition-colors">
                       <input type="hidden" name="idStaff" value="{{id}}"> 
                      <i data-lucide="eye" class="w-3.5 h-3.5"></i> Data
                     </button>
                   </form>
                  {{^isCEO}}
                  <form action="/removestaff" method="post">
                    <button type="submit" class="flex items-center gap-1 bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-200/40 transition-colors">
                      <input type="hidden" name="idStaff" value="{{id}}">
                      <i data-lucide="user-minus" class="w-3 h-3"></i> Out
                    </button>
                  </form>
                  {{/isCEO}}
                  {{#isCEO}}
                  <span class="flex items-center gap-1 bg-stone-100 text-stone-500 text-[11px] font-bold px-2.5 py-1.5 rounded-lg border border-stone-200/60 select-none">
                    <i data-lucide="lock" class="w-3 h-3 text-stone-400"></i> Owner
                  </span>
                  {{/isCEO}}
                </div>
              </td>
            </tr>
            {{/staff}}
           
          </tbody>
        </table>
      </div>

    </div>
  </main>

  <footer class="text-center py-6 text-xs text-stone-400 w-full bg-white border-t border-stone-100">
    &copy; 2026 BatikHub Staff Hub Nusantara. Dashboard Manajemen Internal.
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Panel - Data Penjualan & Omset</title>
  <!-- Menggunakan Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons untuk ikon modern -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#FBF9F4] text-stone-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- NAVBAR UTAMA SYSTEM (STAFF / SELLER) -->
  {{> staff/NavbarMain/navbar}}

  <!-- KONTEN UTAMA DASHBOARD STAFF -->
  <main class="max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-grow space-y-6">
    
    <!-- NAVBAR INTERNAL (OMSET, LIST, TAMBAH, SEDANG DIKIRIM, PROFILE) -->
    {{> staff/NavbarMain/navbarInternal}}

    <!-- RINGKASAN TOTAL OMSET (METRICS CARD) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-5 rounded-2xl border border-stone-200/80 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <p class="text-xs font-medium text-stone-400 uppercase tracking-wider">Total Omset Penjualan</p>
          <h3 class="text-2xl font-bold font-mono text-emerald-800">$ {{totalOmset}}</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center border border-emerald-100">
          <i data-lucide="dollar-sign" class="w-6 h-6"></i>
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-stone-200/80 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <p class="text-xs font-medium text-stone-400 uppercase tracking-wider">Total Produk Terjual</p>
          <h3 class="text-2xl font-bold font-mono text-stone-800">{{totalProdukTerjual}} <span class="text-xs font-sans text-stone-400 font-normal">Pcs</span></h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center border border-amber-100">
          <i data-lucide="check-check" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- TABEL / LIST DATA PENJUALAN PRODUK -->
    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-hidden">
      <!-- Table Header Title -->
      <div class="px-6 py-5 border-b border-stone-100 flex justify-between items-center bg-stone-50/60">
        <div class="flex items-center gap-2">
          <i data-lucide="bar-chart-3" class="w-4 h-4 text-amber-600"></i>
          <h2 class="text-xs font-bold text-stone-700 uppercase tracking-wider">Performa Stok Produk Terjual</h2>
        </div>
        <span class="text-[10px] font-semibold bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full border border-amber-200">
          Live Update
        </span>
      </div>

      <!-- Table Container -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-stone-100 text-[11px] font-bold text-stone-400 uppercase tracking-wider bg-stone-50/30">
              <th class="py-4 px-6">Detail Produk Batik</th>
              <th class="py-4 px-6 text-center">Stok Terjual</th>
              <th class="py-4 px-6 text-right">Sub-Total Nilai</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 text-sm">
            
            <!-- Item 1 -->
             {{#produks}}
            <tr class="hover:bg-stone-50/40 transition-colors">
              <td class="py-4 px-6">
                <div class="font-semibold text-stone-800">{{namaProduk}}</div>
                <div class="text-[11px] text-stone-400 font-mono">ID: {{idProduk}}</div>
              </td>
              <td class="py-4 px-6 text-center font-bold text-stone-700 font-mono">{{stockTerjualPerProduk}}</td>
              <td class="py-4 px-6 text-right font-semibold text-emerald-800 font-mono">$ {{omsetPerProduk}}</td>
            </tr>
            {{/produks}}
            
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- FOOTER PANEL -->
  <footer class="text-center py-6 text-xs text-stone-400 w-full bg-white border-t border-stone-100">
    &copy; 2026 BatikHub Staff Hub Nusantara. Dashboard Manajemen Internal.
  </footer>

  <!-- Script untuk inisialisasi Lucide Icons -->
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Panel - List Barang Dijual</title>
  <!-- Menggunakan Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons untuk ikon modern -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#FBF9F4] text-stone-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- NAVBAR UTAMA SYSTEM (STAFF / SELLER) -->
  {{> staff/NavbarMain/navbar}}

  <!-- KONTEN UTAMA DASHBOARD STAFF -->
  <main class="max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-grow space-y-6">
    
    <!-- NAVBAR INTERNAL DIURANGI (OMSET, LIST, SEDANG DIKIRIM, PROFILE) -->
    {{> staff/NavbarMain/navbarInternal}}

    <!-- HEADER KONTEN LIST BARANG -->
    <div class="flex items-center justify-between bg-white p-4 rounded-xl border border-stone-200/60 shadow-sm">
      <div class="flex items-center gap-2">
        <i data-lucide="boxes" class="w-4 h-4 text-amber-600"></i>
        <h2 class="text-xs font-bold text-stone-700 uppercase tracking-wider">Katalog Inventaris Barang Toko</h2>
      </div>
      <!-- Tombol Tambah Tetap Berada di Sini -->
      <a href="/addproduk" class="flex items-center gap-1 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-[11px] px-3.5 py-2 rounded-xl transition-colors shadow-sm">
        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Tambah Barang Baru
      </a>
    </div>

    <!-- LIST BARANG DENGAN GAMBAR LEBIH BESAR -->
    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-stone-100 text-[11px] font-bold text-stone-400 uppercase tracking-wider bg-stone-50/40">
              <th class="py-4 px-6 w-32">Pratinjau Gambar</th>
              <th class="py-4 px-6">Detail Nama Barang</th>
              <th class="py-4 px-6 text-center">Harga</th>
              <th class="py-4 px-6 text-center">Stok Sisa</th>
              <th class="py-4 px-6 text-center w-28">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 text-sm">
            
            <!-- Barang 1 -->
             {{#produk}}
            <tr class="hover:bg-stone-50/40 transition-colors">
              <td class="py-4 px-6">
                {{#gambar}}
                <div class="w-20 h-20 bg-stone-100 border border-stone-200/80 rounded-xl flex flex-col items-center justify-center text-stone-400 relative overflow-hidden shadow-sm">
                  <img src="data:image/png;base64,{{gambar}}" 
                        alt="{{gambar}}" 
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                </div>
                {{/gambar}}

                {{^gambar}}
                <i data-lucide="shirt" class="w-8 h-8 text-stone-300"></i>
                {{/gambar}}
              </td>
              <td class="py-4 px-6">
                <div class="font-bold text-stone-800 leading-snug">{{namaProduk}}</div>
                <div class="text-[10px] text-stone-400 font-mono mt-1 bg-stone-50 px-2 py-0.5 rounded border border-stone-100 inline-block">
                  Kode: {{idProduk}}
                </div>
              </td>
              <td class="py-4 px-6 text-center font-bold text-emerald-800 font-mono">
                $ {{harga}}
              </td>
              <td class="py-4 px-6 text-center">
                <span class="inline-block bg-emerald-50 text-emerald-800 border border-emerald-200/60 font-bold font-mono text-xs px-3 py-1 rounded-xl shadow-sm">
                  {{stock}} Pcs
                </span>
              </td>
              <td class="py-4 px-6 text-center">
                <div class="flex items-center justify-center gap-1.5">
                  <form action="/editproduct" method="post">
                    <button type="submit" class="p-2 bg-stone-50 hover:bg-stone-100 border border-stone-200 text-stone-600 rounded-xl transition-colors" title="Edit">
                      <input type="hidden" value="{{idProduk}}" name="idProduk">
                      <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </form>

                  <form action="/deleteproduct" method="post">
                    <button type="submit" class="p-2 bg-red-50 hover:bg-red-100 border border-red-100 text-red-600 rounded-xl transition-colors" title="Hapus">
                      <input type="hidden" name="idProduk" value="{{idProduk}}">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            {{/produk}}

          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- FOOTER PANEL -->
  <footer class="text-center py-6 text-xs text-stone-400 w-full bg-white border-t border-stone-100">
    &copy; 2026 BatikHub Staff Hub Nusantara. Dashboard Manajemen Internal.
  </footer>

  <!-- Script untuk inisialisasi Lucide Icons -->
  <script>
    lucide.createIcons();
  </script>
</body>
</html>